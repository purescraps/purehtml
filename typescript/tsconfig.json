{
  "compilerOptions": {
    "esModuleInterop": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "moduleResolution": "node16",
    "target": "ESNext",
    "resolveJsonModule": true,
    "outDir": "dist",
    "module": "node16",
    "types": ["node", "bun"],
    "skipLibCheck": true
  },
  "exclude": ["dist", "docs"]
}
